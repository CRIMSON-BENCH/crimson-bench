# The Crimson Bench — public deploy env
# Set these in your host's Project Settings → Environment Variables (Vercel/Netlify).
# All are optional: when unset, AI shows a friendly "coming soon" and Buy buttons fall back to /contact.

# Gemini AI analysis endpoint — the Lovable/Supabase `ai-analysis` function URL (Lovable Prompt 4).
NEXT_PUBLIC_AI_ENDPOINT=

# Stripe checkout endpoint — the Lovable/Supabase `create-checkout` function URL (Lovable Prompt 2).
NEXT_PUBLIC_CHECKOUT_ENDPOINT=

# (For the entitlement bridge, once wired) Supabase project URL + public anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
